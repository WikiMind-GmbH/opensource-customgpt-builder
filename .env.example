# General settings
APP_DOMAIN=localhost

# Debugging settings
DEBUG_MODE=false # set to "true" if you want to use the debug profile "Backend debugger" to debug code
DEBUG_MODE_LOCUST=false # same as above, but for th locust test files

# Openai Adapter settings
OPENAI_API_KEY=
MODEL_NAME=gpt-5-nano

# Locust settings
LOCUST_DESTINATION=https://albert-test.wikimind.de/api
LOCUST_BASIC_AUTH_USER=
LOCUST_BASIC_AUTH_PASSWORD=

# Database
DB_URL_CHAT=sqlite:///./dev-chat.db
DB_URL_CGPT=sqlite:///./dev-cgpt.db
CREATE_SCHEMA=true

# Upload files settings
LOADED_FILES_PATH=/app_data/loaded_images
UPLOAD_MAX_FILE_SIZE=100000000 # ca 100MB
UPLOAD_ALLOWED_SUFFIXES=.pdf,.csv,.txt,.excel